<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>채팅(WebSocket)</title>
    <style>
        body {margin: 20px; font-family: "Calibri Light"}
        nav a {padding: 8px 15px; margin-right: 10px; background: #666; color: white;
        text-decoration: none}
        .info {color: #666; font-size: 13px;}
        .chat-area {
            border: 1px solid #ccc; height: 300px; padding: 10px;
            overflow-y: scroll; background: #f9f9f9;
        }
        .message {
            padding: 5px 10px; margin: 3px 0; background: white;
            border-radius: 8px; max-width: 80%;
        }
        form {margin-top: 10px; display: flex; gap: 10px;}
        input {flex: 1; padding: 8px;}
        button {padding: 8px 15px; background: #007bff; color: white;border: none}

    </style>
</head>
<body>

<h3>채팅 (WebSocket)</h3>
<p id="status">서버에 연결하는 중...</p>
<div class="chat-area" id="chatArea">
{{#chats}}
    <div class="message">{{msg}}</div>
{{/chats}}
</div>

<form id="chatForm">
    <input type="text" name="msg" id="msg" placeholder="메세지 입력"
           required autofocus>
    <button type="submit">전송</button>
</form>

<script>
    const chatArea = document.getElementById('chatArea');
    const status = document.getElementById('status');
    const chatForm = document.getElementById('chatForm');
    const msgInput = document.getElementById('msg');

    //받은 메세지를 화면 맨 아래 추가한다.
    function appendMessage(msg) {
        const div = document.createElement("div")
        div.className = "message";
        div.textContent = msg;
        chatArea.appendChild(div);
        chatArea.scrollTop = chatArea.scrollHeight;
    }

    //WebSocket 연결
    // 메시지 규칙 접두사. 서버측(ChatWebSocketHandler)와 똑같이 맞줘야한다
    const PREFIX_CHAT = "CHAT:";
    const PREFIX_MESSAGE = "MESSAGE:";
    const PREFIX_ERROR = "ERROR:";

    //1. 서버에 웹소켓 연결을 연다 (브라우저 내장 객체)
    //tip : 페이지가 http면 ws://, https면 wss:// 로 연결한다
    const protocol = location.protocol === 'https:' ? 'wss://' : 'ws://';
    const soket = new WebSocket(protocol + location.host + '/ws-chat');
    console.log("주소확인 : ", protocol + location.host + '/ws-chat');

    //2. 연결이 열리면 (101) 확인
    soket.onopen = () => {
        status.textContent = '서버와 연결됨 (WebSocket)'
    };

    //3. 서버가메시지를 보내면 접두사를 확인하고 나눈다
    soket.onmessage = (e) => {
        const text = e.data;

        if (text.startsWith(PREFIX_MESSAGE)){
            appendMessage(text.substring(PREFIX_MESSAGE.length));
        } else if (text.startsWith(PREFIX_ERROR)){
            alert(text.substring(PREFIX_ERROR.length));
        } else {
            console.log("규칙이 없는 메세지: " + text);
        }
    };

    //4. 연결이 닫히면 내용을 수정한다 (확인용)
    soket.onclose = (e) => {
        status.textContent = '연결이 끊겼습니다 새로고침 하면 다시 연결 됨';
    };

    //5. 전송
    chatForm.addEventListener('submit', (e) => {
        e.preventDefault();
        const msg = msgInput.value.trim();

        if (msg === '') return;

        //연결이 열린 상태(open)에서만 보낼수잇다, 연결 중에 send를 부르면 오류
        if (soket.readyState !== WebSocket.OPEN) {
            alert("서버와 연결되어 있지 않습니다");
            return;
        }
        soket.send(PREFIX_CHAT + msg);
        msgInput.value = '';
        msgInput.focus();
    });




    //처음 그려진 메세지 중 최신 메이시가 보이도록 스크롤을 맨아래로 내린다
    chatArea.scrollTop = chatArea.scrollHeight;

</script>
</body>
</html>