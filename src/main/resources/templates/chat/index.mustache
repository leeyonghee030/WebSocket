<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport"
          content="width=device-width, user-scalable=no, initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>채팅(STOMP)</title>
<!--    STOMP 클라이언트 라이브러리-->
    <script src="https://cdn.jsdelivr.net/npm/@stomp/stompjs@7.5.0/bundles/stomp.umd.min.js"></script>
    <style>
        body {margin: 20px; font-family: "Calibri Light"}
        nav a {padding: 8px 15px; margin-right: 10px; background: #666; color: white;
        text-decoration: none}
        .info {color: #666; font-size: 13px;}
        .chat-area {
            border: 1px solid #ccc; height: 300px; padding: 10px;
            overflow-y: scroll; background: #f9f9f9;
        }
        .message {
            padding: 5px 10px; margin: 3px 0; background: white;
            border-radius: 8px; max-width: 80%;
        }
        form {margin-top: 10px; display: flex; gap: 10px;}
        input {flex: 1; padding: 8px;}
        button {padding: 8px 15px; background: #007bff; color: white;border: none}

    </style>
</head>
<body>

<nav>
    <a href="/rooms/1">1번방</a>
    <a href="/rooms/2">2번방</a>
    <a href="/rooms/3">3번방</a>
</nav>

<h3>채팅 (STOMP)</h3>
<p id="status">서버에 연결하는 중...</p>
<div class="chat-area" id="chatArea">
{{#chats}}
    <div class="message">{{msg}}</div>
{{/chats}}
</div>

<form id="chatForm">
    <input type="text" name="sender" id="sender" placeholder="이름 입력" value="익명"
           required autofocus>
    <input type="text" name="msg" id="msg" placeholder="메세지 입력"
           required autofocus>
    <button type="submit">전송</button>
</form>


<script>
    //서버가 그려준 현재방 번호
    const roomId = `{{roomId}}`;

    const chatArea = document.getElementById('chatArea');
    const status = document.getElementById('status');
    const chatForm = document.getElementById('chatForm');
    const msgInput = document.getElementById('msg');

    //받은 메세지를 화면 맨 아래 추가한다.
    function appendMessage(sender, msg) {
        const div = document.createElement("div")
        div.className = "message";

        const nameSpan = document.createElement("span");
        nameSpan.className = "name";
        nameSpan.textContent = sender+" : ";

        div.appendChild(nameSpan);
        div.appendChild(document.createTextNode(msg))

        chatArea.appendChild(div);
        chatArea.scrollTop = chatArea.scrollHeight;
    }

    //Stomp 클라이언트를 만든다
    const protocol = location.protocol === 'https:' ? 'wss://' : 'ws://';
    const client = new StompJs.Client({
        brokerURL : protocol + location.host + "/ws-stomp",
        reconnectDelay: 5000 // 연결 끊어 지면 5초마다 자동으로 다시 연결
    })

    //2. 연결이 되면 이 방의 주소를 구독한다
    client.onConnect = () => {
        status.textContent = "서버와 연결됨 (STOMP) : " + roomId + "번 방";
        client.subscribe('/sub/chat/' + roomId, (message) => {
            const dto = JSON.parse(message.body);
            appendMessage(dto.sender, dto.msg);
        });
    }

    //3. 연결이 끊기면 알아서 다시 시도한다
    client.onWebSocketClose = () => {
        status.textContent = "잠시 연결중단 자동으로 재 연결 처리중 ...";
    }
    // 4. 서버가 error 프레임을 보내면 콘솔남기기
    client.onStompError = (frame) =>{
        console.log("STOMP 오류 :", frame.headers['message']);
    }

    //연결시작 (콜백을 다 등록한 뒤에 시작)
    client.activate();
    //5. 전송 json 으로 변경해서 /sub/chat/방번호로 던진다
    chatForm.addEventListener("submit", (e) => {
        e.preventDefault();
        const msg = msgInput.value.trim();
        if (msg === '') return;
        if (!client.connected){
            alert("서버와 연결되어 있지 않습니다");
            return;
        }

        const dto = {sender: document.getElementById("sender").value, msg: msg}

        client.publish({destination: '/pub/chat/' +roomId, body:JSON.stringify(dto)});
        msgInput.value ='';
        msgInput.focus();

    });





    //처음 그려진 메세지 중 최신 메이시가 보이도록 스크롤을 맨아래로 내린다
    chatArea.scrollTop = chatArea.scrollHeight;

</script>
</body>
</html>